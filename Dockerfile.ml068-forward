# Strictly isolated PUBLIC MARKET GET, PAPER SIMULATION ONLY image.
# No bot.js, API credentials, order code, websocket trading, or private endpoints.
FROM node:22-alpine
WORKDIR /app
COPY lib/accelerator-core.mjs lib/accelerator-data.mjs lib/accelerator-ml.mjs \
     lib/frozen-ml-forward-strategy.mjs lib/frozen-ml-forward-ledger.mjs ./lib/
COPY scripts/ml068-paper-cron.mjs ./scripts/
COPY models/frozen-ml068-20261108.json ./models/
RUN mkdir -p /forward-data
ENV PAPER_TRADING=true LIVE_TRADING_ENABLED=false LIVE_TRADING_APPROVED=false
CMD ["node","scripts/ml068-paper-cron.mjs"]
